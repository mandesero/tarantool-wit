@since(version = 0.2.0)
interface index {

    @since(version = 0.2.0)
    use types.{index, box-error, box-tuple, iterator-type, msgpack-value};
  
    /// Returns the number of tuples stored in the index.
    ///
    /// ### Parameters
    /// - `index`: The index to query.
    ///
    /// ### Returns
    /// - The number of tuples in the index, or a `box-error` on failure.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.2.0)
    tuple-count: func(index: index) -> result<u64, box-error>;
  
    /// Returns the memory size of the index in bytes.
    ///
    /// ### Parameters
    /// - `index`: The index to inspect.
    ///
    /// ### Returns
    /// - Size in bytes, or a `box-error`.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.2.0)
    memory-size: func(index: index) -> result<u64, box-error>;
  
    /// Returns a random tuple from the index.
    ///
    /// ### Parameters
    /// - `index`: The index to read from.
    /// - `rnd`: A random seed value.
    ///
    /// ### Returns
    /// - `some` with an owned tuple handle, or `none` if the index is empty.
    ///   The caller must release a returned handle with the public `release`
    ///   function from the `tarantool:tarantool/box-tuple` interface.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.2.0)
    random: func(index: index, rnd: u32) -> result<option<box-tuple>, box-error>;
  
    /// Gets a tuple by key from the index.
    ///
    /// The key must be one complete MessagePack array, for example `[1]`.
    ///
    /// ### Parameters
    /// - `index`: The index to search.
    /// - `key`: MessagePack array containing exactly one item per index part.
    ///
    /// ### Returns
    /// - `some` with an owned tuple handle, or `none` if no tuple matches.
    ///   The caller must release a returned handle with the public `release`
    ///   function from the `tarantool:tarantool/box-tuple` interface.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.2.0)
    get: func(index: index, key: msgpack-value) -> result<option<box-tuple>, box-error>;
  
    /// Finds the minimal tuple matching the given key.
    ///
    /// ### Parameters
    /// - `index`: The index to search.
    /// - `key`: MessagePack array containing zero or more key parts.
    ///
    /// ### Returns
    /// - `some` with an owned tuple handle, or `none` if no tuple matches.
    ///   The caller must release a returned handle with the public `release`
    ///   function from the `tarantool:tarantool/box-tuple` interface.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.2.0)
    min: func(index: index, key: msgpack-value) -> result<option<box-tuple>, box-error>;
  
    /// Finds the maximal tuple matching the given key.
    ///
    /// ### Parameters
    /// - `index`: The index to search.
    /// - `key`: MessagePack array containing zero or more key parts.
    ///
    /// ### Returns
    /// - `some` with an owned tuple handle, or `none` if no tuple matches.
    ///   The caller must release a returned handle with the public `release`
    ///   function from the `tarantool:tarantool/box-tuple` interface.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.2.0)
    max: func(index: index, key: msgpack-value) -> result<option<box-tuple>, box-error>;
  
    /// Counts the number of tuples matching the given key and iterator type.
    ///
    /// ### Parameters
    /// - `index`: Index to query.
    /// - `mode`: Iterator mode used to match tuples.
    /// - `key`: MessagePack array containing zero or more key parts.
    ///
    /// ### Returns
    /// - Count of matching tuples, or an error.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.2.0)
    count: func(index: index, mode: iterator-type, key: msgpack-value) -> result<u64, box-error>;

    /// Index iterator resource for scanning tuples.
    @since(version = 0.2.0)
    resource iterator {
        /// Allocate and initialize an iterator for the given index.
        ///
        /// - `index`: the index to scan.
        /// - `mode`: Scan mode (see `tarantool:tarantool/types::iterator-type`).
        /// - `key`: MessagePack array containing zero or more key parts.
        ///
        /// Returns either a new `iterator` or a `box-error`.
        @since(version = 0.2.0)
        new: static func(
            index: index,
            mode: iterator-type,
            key: msgpack-value
        ) -> result<iterator, box-error>;

        /// Advance the iterator and return the next tuple.
        ///
        /// Returns `some` with an owned tuple handle, or `none` when the
        /// iterator is exhausted. The caller must release a returned handle
        /// with the public `release` function from the
        /// `tarantool:tarantool/box-tuple` interface.
        @since(version = 0.2.0)
        next: func() -> result<option<box-tuple>, box-error>;
    }
}
