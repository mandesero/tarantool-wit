@since(version = 0.2.0)
/// General database operations exposed by Tarantool's `box` API.
///
/// Functions returning `result` preserve Tarantool failures as `box-error`.
/// An `option` inside a successful result represents a normal missing object.
interface database {

    @since(version = 0.2.0)
    use types.{space, box-error, index, box-tuple, msgpack-value};

    /// Returns the current schema version of the database.
    ///
    /// The version changes when Tarantool modifies schema objects such as
    /// spaces or indexes.
    ///
    /// ### Returns
    /// - The current unsigned schema version.
    @since(version = 0.2.0)
    schema-version: func() -> u32;

    /// Retrieves a space object by its name.
    ///
    /// The returned record contains a catalog ID and does not own host state.
    ///
    /// ### Parameters
    /// - `name`: The name of the space to retrieve.
    ///
    /// ### Returns
    /// - `some` with the space, or `none` if no space has this name.
    @since(version = 0.2.0)
    space-by-name: func(name: string) -> result<option<space>, box-error>;

    /// Retrieves an index object by name within a space.
    ///
    /// The returned record contains catalog IDs and does not own host state.
    ///
    /// ### Parameters
    /// - `space`: The space to search within.
    /// - `name`: The name of the index to retrieve.
    ///
    /// ### Returns
    /// - `some` with the index, or `none` if the space has no index with this
    ///   name.
    @since(version = 0.2.0)
    index-by-name: func(%space: space, name: string) -> result<option<index>, box-error>;

    /// Inserts a new tuple into a space.
    ///
    /// The tuple must be one complete MessagePack array:
    /// `[field1, field2, ...]`.
    ///
    /// ### Parameters
    /// - `space`: The target space.
    /// - `tup`: One complete MessagePack array containing the tuple fields.
    ///
    /// ### Returns
    /// - An owned handle to the inserted tuple. The caller must eventually
    ///   release it with the public `release` function from the
    ///   `tarantool:tarantool/box-tuple` interface.
    @since(version = 0.2.0)
    insert: func(space: space, tup: msgpack-value) -> result<box-tuple, box-error>;

    /// Updates an existing tuple by key in the specified index.
    ///
    /// - `key` must be a MessagePack array identifying the tuple, for example
    ///   `[1]`.
    /// - `ops` must be a MessagePack array of operations, for example
    ///   `[["=", 2, 30]]`.
    ///
    /// ### Parameters
    /// - `index`: The index to use for locating the tuple.
    /// - `key`: One complete MessagePack array containing exactly one item per
    ///   index part.
    /// - `ops`: One complete MessagePack array whose items are update-operation
    ///   arrays.
    ///
    /// ### Returns
    /// - `some` with an owned handle to the updated tuple, or `none` if no tuple
    ///   matches the key. The caller must release a returned handle with the
    ///   public `release` function from the `tarantool:tarantool/box-tuple`
    ///   interface.
    @since(version = 0.2.0)
    update: func(
        index: index,
        key: msgpack-value,
        ops: msgpack-value,
    ) -> result<option<box-tuple>, box-error>;

    /// Replaces an existing tuple or inserts a new one.
    ///
    /// ### Parameters
    /// - `space`: The space to operate on.
    /// - `tup`: One complete MessagePack array containing the new tuple fields.
    ///
    /// ### Returns
    /// - An owned handle to the replaced tuple. The caller must eventually
    ///   release it with the public `release` function from the
    ///   `tarantool:tarantool/box-tuple` interface.
    @since(version = 0.2.0)
    replace: func(space: space, tup: msgpack-value) -> result<box-tuple, box-error>;

    /// Performs an UPSERT operation: update if exists, insert otherwise.
    ///
    /// ### Parameters
    /// - `index`: The index used for key lookup.
    /// - `tup`: One complete MessagePack tuple array to insert.
    /// - `ops`: One complete MessagePack array whose items are update-operation
    ///   arrays.
    ///
    /// ### Returns
    /// - `ok(())` after Tarantool applies the upsert.
    ///
    /// ### Errors
    /// - A `box-error` if the tuple, key, or operations are invalid, or if the
    ///   operation otherwise fails.
    @since(version = 0.2.0)
    upsert: func(index: index, tup: msgpack-value, ops: msgpack-value) -> result<_, box-error>;

    /// Deletes a tuple by key from the specified index.
    ///
    /// The key must be encoded as a MessagePack array, for example `[1]`.
    ///
    /// ### Parameters
    /// - `index`: The index used for key lookup.
    /// - `key`: One complete MessagePack array containing exactly one item per
    ///   index part.
    ///
    /// ### Returns
    /// - `some` with an owned handle to the deleted tuple, or `none` if no tuple
    ///   matches the key. The caller must release a returned handle with the
    ///   public `release` function from the `tarantool:tarantool/box-tuple`
    ///   interface.
    @since(version = 0.2.0)
    delete: func(index: index, key: msgpack-value) -> result<option<box-tuple>, box-error>;

    /// Removes all tuples from the space.
    ///
    /// This operation is equivalent to SQL's `TRUNCATE TABLE`.
    ///
    /// ### Parameters
    /// - `space`: The target space to truncate.
    ///
    /// ### Returns
    /// - `ok(())` after the space is empty.
    @since(version = 0.2.0)
    truncate: func(space: space) -> result<_, box-error>;
}

