
@since(version = 0.1.2)
interface error {

    use types.{box-error, error-code};
  
    /// Creates a new error object.
    ///
    /// Corresponds to `box.error.new{ ... }`.
    ///
    /// ### Parameters
    /// - `code`: Raw numeric Tarantool error code. Codes unknown to this WIT
    ///   package are accepted without remapping.
    /// - `message`: The error message.
    ///
    /// ### Returns
    /// - A new `box-error` object.
    @since(version = 0.1.2)
    new: func(code: error-code, message: string) -> box-error;

    /// Creates a new error object with the given message, code and source location.
    ///
    /// Corresponds to `box.error.new{ ... }`.
    ///
    /// ### Parameters
    /// - `code`: Raw numeric Tarantool error code. Codes unknown to this WIT
    ///   package are accepted without remapping.
    /// - `message`: The error message.
    /// - `file`: File name.
    /// - `line`: Line number in file.
    ///
    /// ### Returns
    /// - A new `box-error` object.
    @since(version = 0.1.2)
    new-with-location: func(code: error-code, message: string, file: option<string>, line: option<u32>) -> box-error;
  
    /// Sets the given error as the current "last error".
    ///
    /// Corresponds to `box.error.set(err)`.
    ///
    /// ### Parameters
    /// - `err`: The error to set.
    @since(version = 0.1.0)
    set: func(err: box-error);

    /// Returns the last error set by the system or user code.
    ///
    /// Corresponds to `box.error.last()`.
    /// Returns `none` if no error is currently set.
    @since(version = 0.1.0)
    last: func() -> option<box-error>;

    /// Clears the last error.
    ///
    /// Corresponds to `box.error.clear()`.
    @since(version = 0.1.0)
    clear: func();

    /// Converts a `box-error` object to a string representation.
    ///
    /// Equivalent to `tostring(err)` in Tarantool.
    ///
    /// ### Parameters
    /// - `err`: The error to stringify.
    ///
    /// ### Returns
    /// - A human-readable string describing the error.
    @since(version = 0.1.0)
    to-string: func(err: box-error) -> string;
}
