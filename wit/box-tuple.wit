@since(version = 0.1.0)
interface box-tuple {
  
    @since(version = 0.1.0)
    use types.{box-error, box-tuple, tuple-field, tuple-format, key-def, msgpack-value};
  
    /// Creates a new tuple from MessagePack data using the default tuple format.
    ///
    /// The data must be a MessagePack-encoded array (for example,
    /// `[1, "abc", {"x": 42}]`).
    ///
    /// ### Parameters
    /// - `data`: One complete MessagePack array containing the tuple fields.
    ///
    /// ### Returns
    /// - A new owned `box-tuple` handle, or `box-error`. The caller must
    ///   eventually release it with the public `release` function in this
    ///   interface.
    /// 
    /// ### Raises
    /// - `box-error
    @since(version = 0.1.0)
    new: func(data: msgpack-value) -> result<box-tuple, box-error>;
  
    /// Increases the reference count of the tuple.
    ///
    /// Call this to acquire one additional ownership reference for the same
    /// handle. Copying the handle alone does not acquire a reference.
    ///
    /// ### Parameters
    /// - `t`: The tuple to retain.
    ///
    @since(version = 0.1.0)
    retain: func(t: box-tuple);
  
    /// Decreases the reference count of the tuple.
    ///
    /// If the count reaches zero, the handle and all of its aliases become
    /// stale. Releasing a stale handle traps.
    ///
    /// ### Parameters
    /// - `t`: The tuple to release.
    @since(version = 0.1.0)
    release: func(t: box-tuple);
  
    /// Returns the number of fields in the tuple (i.e., array size).
    ///
    /// ### Parameters
    /// - `t`: The tuple.
    ///
    /// ### Returns
    /// - Field count as `u32`.
    @since(version = 0.1.0)
    field-count: func(t: box-tuple) -> u32;
  
    /// Returns the byte size of the internal MessagePack data.
    ///
    /// Useful for buffer allocations.
    ///
    /// ### Parameters
    /// - `t`: The tuple.
    ///
    /// ### Returns
    /// - Number of bytes used as `u64`.
    @since(version = 0.1.0)
    byte-size: func(t: box-tuple) -> u64;
  
    /// Serializes the tuple to a MessagePack byte array.
    ///
    /// This data can be passed to the public `to-json` function from the
    /// `tarantool:tarantool/msgpack` interface or to another MessagePack
    /// decoder.
    ///
    /// ### Parameters
    /// - `t`: The tuple.
    ///
    /// ### Returns
    /// - One complete MessagePack array containing the tuple fields.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.1.0)
    to-bytes: func(t: box-tuple) -> result<msgpack-value, box-error>;
  
    /// Returns the format object associated with the tuple.
    ///
    /// ### Parameters
    /// - `t`: The tuple.
    ///
    /// ### Returns
    /// - An owned handle to the `tuple-format` used to construct the tuple.
    ///   The caller must eventually release it with the public `release`
    ///   function from the `tarantool:tarantool/tuple-format` interface.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.1.0)
    format: func(t: box-tuple) -> tuple-format;
  
    /// Returns the field at the specified index (zero-based).
    ///
    /// The returned value contains one complete copied MessagePack value.
    ///
    /// ### Parameters
    /// - `t`: The tuple.
    /// - `idx`: Field index (starting from 0).
    ///
    /// ### Returns
    /// - `some` with a copied field, or `none` if `idx` is out of range.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.1.0)
    field: func(t: box-tuple, idx: u32) -> result<option<tuple-field>, box-error>;
  
    /// Returns a copied field selected by a JSON path expression.
    ///
    /// ### Parameters
    /// - `t`: The tuple.
    /// - `path`: Path expression (e.g., `"[2].x"`).
    /// Array indexes in the path are zero-based.
    ///
    /// ### Returns
    /// - `some` with a copied field, or `none` if the path selects no field.
    ///
    /// ### Raises
    /// - `box-error
    /// 
    /// ### Examples
    ///
    /// **Python**
    /// ```
    /// field = tt_tuple.field_by_path(tup, "[1].x")
    /// value = None if field is None else json.loads(msgpack.to_json(field))
    /// ```
    @since(version = 0.1.0)
    field-by-path: func(t: box-tuple, path: string) -> result<option<tuple-field>, box-error>;
  
    /// Updates fields in a tuple using the given update expression.
    ///
    /// The expression must be a MessagePack-encoded array of operations like:
    /// `[["=", 1, "new_value"]]`, where the first item is an operation, second is field index, and third is the value.
    ///
    /// ### Parameters
    /// - `t`: The tuple to update.
    /// - `expr`: One complete MessagePack array whose items are update-operation
    ///   arrays.
    ///
    /// ### Returns
    /// - A new owned `box-tuple` handle with applied updates, or a `box-error`.
    ///   The caller must eventually release it with the public `release`
    ///   function in this interface.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.1.0)
    update: func(t: box-tuple, expr: msgpack-value) -> result<box-tuple, box-error>;
  
    /// Performs an upsert operation on the tuple using the provided expression.
    ///
    /// This operation applies updates if the field exists or appends otherwise.
    /// Common upsert usage includes incrementing fields: `[["+", 2, 1]]`.
    ///
    /// ### Parameters
    /// - `t`: The tuple.
    /// - `expr`: One complete MessagePack array whose items are update-operation
    ///   arrays.
    ///
    /// ### Returns
    /// - A new owned `box-tuple` handle with the result, or a `box-error`.
    ///   The caller must eventually release it with the public `release`
    ///   function in this interface.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.1.0)
    upsert: func(t: box-tuple, expr: msgpack-value) -> result<box-tuple, box-error>;
  
    /// Validates a tuple against the given format.
    ///
    /// Checks field types and nullability constraints.
    ///
    /// ### Parameters
    /// - `t`: The tuple to validate.
    /// - `format`: Tuple format to validate against.
    ///
    /// ### Returns
    /// - `ok` if the tuple conforms to the format.
    ///
    /// A tuple that does not conform is returned as a `box-error`; it is not a
    /// normal boolean result.
    ///
    /// ### Raises
    /// - `box-error
    @since(version = 0.1.0)
    validate: func(t: box-tuple, format: tuple-format) -> result<_, box-error>;
  
    /// Compares two tuples using a given key definition.
    ///
    /// The comparison is lexicographical by key fields.
    ///
    /// ### Parameters
    /// - `key-def`: Definition of fields to compare.
    /// - `left`: First tuple.
    /// - `right`: Second tuple.
    /// 
    /// ### Returns
    /// - `0` if equal
    /// - `<0` if `left < right`
    /// - `>0` if `left > right`
    @since(version = 0.1.0)
    compare: func(key-def: key-def, left: box-tuple, right: box-tuple) -> s32;
  
    /// Compares a tuple with a key using the given key definition.
    ///
    /// ### Parameters
    /// - `tuple`: Tuple to compare.
    /// - `key`: One complete MessagePack array of key parts.
    /// - `key-def`: Key definition.
    ///
    /// ### Returns
    /// - `0` if key matches tuple
    /// - `<0` if tuple < key
    /// - `>0` if tuple > key
    ///
    /// ### Raises
    /// - `box-error` if `key` is malformed, is not an array, does not match the
    ///   key definition, or if comparison fails.
    @since(version = 0.1.0)
    compare-with-key: func(
        %tuple: box-tuple,
        key: msgpack-value,
        key-def: key-def,
    ) -> result<s32, box-error>;
  
    @since(version = 0.1.0)
    resource iterator {
        /// Creates a new iterator over the fields of a tuple.
        ///
        /// This allows sequential or random access to MessagePack fields within
        /// the tuple.
        ///
        /// ### Parameters
        /// - `tuple`: Borrowed for this call. The returned iterator retains the
        ///   tuple independently, so the caller may release its tuple handle
        ///   after this function returns.
        ///
        /// ### Returns
        /// - A new `iterator` resource, or a `box-error`. Dropping the
        ///   iterator releases its retained tuple reference.
        /// 
        /// ### Raises
        /// - `box-error
        @since(version = 0.1.0)
        new: static func(%tuple: box-tuple) -> result<iterator, box-error>;
    
        /// Returns the current iterator position (index of the next field).
        ///
        /// ### Returns
        /// - The next field index (zero-based).
        @since(version = 0.1.0)
        position: func() -> u32;
    
        /// Rewinds the iterator to the beginning of the tuple.
        ///
        /// After this call, the next field will be the first.
        @since(version = 0.1.0)
        rewind: func();
    
        /// Seeks to a given field index in the tuple.
        ///
        /// The next call to `next()` will return this field.
        ///
        /// ### Parameters
        /// - `pos`: Zero-based field index to seek to.
        ///
        /// ### Returns
        /// - `some` with a copied field, or `none` if `pos` is outside the
        ///   tuple.
        ///
        /// ### Raises
        /// - `box-error
        @since(version = 0.1.0)
        seek: func(pos: u32) -> result<option<tuple-field>, box-error>;
    
        /// Returns the next field in the tuple.
        ///
        /// Returns `none` if there are no more fields.
        ///
        /// ### Returns
        /// - `some` containing a copied `tuple-field`, or `none` when the
        ///   iterator is exhausted.
        ///
        /// ### Raises
        /// - `box-error
        @since(version = 0.1.0)
        next: func() -> result<option<tuple-field>, box-error>;
    }
}
