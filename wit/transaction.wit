@since(version = 0.2.0)
/// Controls the transaction associated with the current execution context.
interface transaction {

    @since(version = 0.2.0)
    use types.{box-error, transaction-isolation};

    /// Returns the current transaction ID.
    ///
    /// A transaction ID is a non-persistent identifier of the current
    /// transaction. Returns `none` if no transaction is active.
    ///
    /// ### Returns
    /// - `some` with the unsigned transaction ID, or `none`.
    @since(version = 0.2.0)
    id: func() -> option<u64>;

    /// Returns the isolation level of the current transaction.
    ///
    /// Returns `none` if there is no active transaction.
    ///
    /// ### Returns
    /// - `some` with the current isolation level, or `none`.
    @since(version = 0.2.0)
    isolation: func() -> option<transaction-isolation>;

    /// Begins a new transaction.
    ///
    /// Fails if the current execution context already has an active
    /// transaction.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    begin: func() -> result<_, box-error>;

    /// Commits the current transaction.
    ///
    /// Finalizes the transaction and applies its changes.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    commit: func() -> result<_, box-error>;

    /// Rolls back the current transaction.
    ///
    /// Discards all changes made within the current transaction.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    rollback: func() -> result<_, box-error>;

    /// Sets the isolation level for the current transaction.
    ///
    /// Call this before the first DML operation in the transaction.
    ///
    /// ### Parameters
    /// - `isolation`: A `transaction-isolation` value.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    set-isolation: func(isolation: transaction-isolation) -> result<_, box-error>;

    /// Requires synchronous replication for the current transaction.
    ///
    /// Commit waits for the configured synchronous replication acknowledgements.
    /// This function has no effect when no transaction is active.
    @since(version = 0.2.0)
    make-synchronous: func();
  }

