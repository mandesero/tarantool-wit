@since(version = 0.1.2)
interface types {

  /// Exactly one complete MessagePack value encoded as bytes.
  ///
  /// The byte sequence must contain one value and no trailing bytes. Functions
  /// further constrain its shape where required, for example to an array or a
  /// map. Values returned by the host are copied into guest-owned memory.
  @since(version = 0.1.2)
  type msgpack-value = list<u8>;

  /// Tarantool error codes.
  ///
  /// Mirrors the `ER_*` constants (`enum errcode`) used by
  /// [`box.error`](https://www.tarantool.io/en/doc/latest/reference/reference_lua/box_error/).
  /// Values match `struct errcode_record.errcode` in the C API.
  enum error-code {
      unknown,
      illegal-params,
      memory-issue,
      tuple-found,
      unsupported,
      readonly,
      injection,
      create-space,
      space-exists,
      drop-space,
      altspace,
      index-type,
      modify-index,
      last-drop,
      tuple-format-limit,
      drop-primary-key,
      key-part-type,
      exact-match,
      invalid-msgpack,
      tuple-not-array,
      field-type,
      index-part-type-mismatch,
      update-splice,
      update-arg-type,
      format-mismatch-index-part,
      unknown-update-op,
      update-field,
      function-tx-active,
      key-part-count,
      proc-lua,
      no-such-proc,
      no-such-trigger,
      no-such-index-id,
      no-such-space,
      no-such-field-no,
      exact-field-count,
      field-missing,
      wal-io,
      more-than-one-tuple,
      access-denied,
      create-user,
      drop-user,
      no-such-user,
      usexists,
      creds-mismatch,
      unknown-request-type,
      unknown-schema-object,
      create-function,
      no-such-function,
      function-exists,
      before-replace-ret,
      multistatement-transaction,
      triggexists,
      usmax,
      no-such-engine,
      reload-cfg,
      cfg,
      savepoint-empty-tx,
      no-such-savepoint,
      unknown-replica,
      replicaset-uuid-mismatch,
      invalid-uuid,
      replicaset-uuid-is-ro,
      instance-uuid-mismatch,
      replica-id-is-reserved,
      missing-request-field,
      identifier,
      drop-function,
      iterator-type,
      replica-max,
      no-connection,
      timeout,
      active-transaction,
      cursor-no-transaction,
      no-such-role,
      role-exists,
      create-role,
      index-exists,
      session-closed,
      role-loop,
      grant,
      priv-granted,
      role-granted,
      priv-not-granted,
      role-not-granted,
      missing-snapshot,
      cant-update-primary-key,
      update-integoverflow,
      guest-uspassword,
      transaction-conflict,
      unsupported-priv,
      load-function,
      function-language,
      rtree-rect,
      proc-c,
      protocol,
      wrong-index-record,
      wrong-index-parts,
      wrong-index-options,
      wrong-schema-version,
      memtx-max-tuple-size,
      wrong-space-options,
      unsupported-index-feature,
      view-is-ro,
      no-transaction,
      system,
      loading,
      connection-to-self,
      compression,
      checkpoint-in-progress,
      sub-stmt-max,
      commit-in-sub-stmt,
      rollback-in-sub-stmt,
      decompression,
      invalid-xlog-type,
      already-running,
      index-field-count-limit,
      local-instance-id-is-read-only,
      backup-in-progress,
      read-view-aborted,
      invalid-index-file,
      invalid-run-file,
      invalid-vylog-file,
      cascade-rollback,
      vy-quota-timeout,
