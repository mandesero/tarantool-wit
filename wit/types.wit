  /// Indexed field types
  @since(version = 0.1.2)
  enum field-type {
    boolean,
    integer,
    unsigned,
    double,
    number,
    decimal,
    %string,
    varbinary,
    uuid,
    datetime,
    array,
    %map,
    scalar,
  }

  /// Definition of a single key part in a Tarantool index.
  @since(version = 0.1.2)
  record key-part {
    /// Field index in the tuple (0-based).
    field-no: u32,
    /// Field type as a string, e.g., "unsigned", "string".
    %field-type: field-type,
    /// Optional collation name for string comparison.
    %collation: option<collation>,
    /// JSON path for multikey indexes (if applicable). If set, `field-type`
    /// refers to the nested field type.
    path: option<string>,
    /// Nullable/exclude-null flags for this key part.
    %flags: key-part-flags,
  }

  /// Opaque host-issued handle to a Tarantool tuple.
  ///
  /// The handle is meaningful only in the component instance that created it.
  /// Consumers must not construct or modify handle values. Each returned
  /// handle owns one reference unless documented otherwise and must be
  /// released with the public `unref` function from the
  /// `tarantool:tarantool/box-tuple` interface. This is an interface function,
  /// not a method on this record.
  @since(version = 0.1.2)
  record box-tuple {
    handle: u64,
  }

  /// Opaque host-issued handle to a Tarantool key definition.
  ///
  /// The handle is meaningful only in the component instance that created it.
  /// Consumers must not construct or modify handle values. Each returned
  /// handle is owned and must be released with the public `delete` function
  /// from the `tarantool:tarantool/key-def` interface. This is an interface
  /// function, not a method on this record.
  @since(version = 0.1.2)
  record key-def {
    handle: u64,
  }

  /// Opaque host-issued handle to a Tarantool tuple format.
  ///
  /// Each `box-tuple` has an associated `tuple-format`. The default format
  /// (see `tarantool:tarantool/tuple-format::default`) is used for tuples not
  /// attached to any space.
  ///
  /// The handle is meaningful only in the component instance that created it.
  /// Consumers must not construct or modify handle values. Each returned
  /// handle owns one reference unless documented otherwise and must be
  /// released with the public `unref` function from the
  /// `tarantool:tarantool/tuple-format` interface. This is an interface
  /// function, not a method on this record.
  @since(version = 0.1.2)
  record tuple-format {
    handle: u64,
  }

  /// A copied tuple field encoded as one complete MessagePack value.
  @since(version = 0.1.2)
  type tuple-field = msgpack-value;
}
