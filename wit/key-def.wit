@since(version = 0.2.0)
/// Builds key definitions used to validate, extract, and compare tuple keys.
///
/// Every returned handle is owned and must be released through this interface.
interface key-def {

    @since(version = 0.2.0)
    use types.{box-error, box-tuple, key-def, key-part, msgpack-value};

    /// Creates a new key definition from a list of parts.
    ///
    /// Each key part selects a tuple field and defines its type, optional
    /// collation, optional path, and flags.
    ///
    /// ### Parameters
    /// - `parts`: List of `key-part` objects.
    ///
    /// ### Returns
    /// - A new owned `key-def` handle on success. The caller must eventually
    ///   release it with the public `release` function in this interface.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    new: func(parts: list<key-part>) -> result<key-def, box-error>;

    /// Creates a deep copy of the given key definition.
    ///
    /// The returned `key-def` is independent of the original and owns one
    /// reference.
    ///
    /// ### Parameters
    /// - `key-def`: The key definition to duplicate.
    ///
    /// ### Returns
    /// - A new owned `key-def` handle independent of the original. The caller
    ///   must eventually release it with the public `release` function in this
    ///   interface.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    duplicate: func(key-def: key-def) -> result<key-def, box-error>;

    /// Merges two key definitions into one.
    ///
    /// Fields from the right-hand side are appended when they do not duplicate
    /// fields from the left-hand side.
    ///
    /// ### Parameters
    /// - `left`: The base key definition.
    /// - `right`: The key definition to append fields from.
    ///
    /// ### Returns
    /// - A new owned `key-def` handle. The caller must eventually release it
    ///   with the public `release` function in this interface.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    merge: func(left: key-def, right: key-def) -> result<key-def, box-error>;

    /// Releases a key definition and invalidates all aliases of its handle.
    ///
    /// Call this once for every key definition returned by `new`,
    /// `duplicate`, or `merge`. Releasing a stale handle traps.
    ///
    /// ### Parameters
    /// - `key-def`: The key definition to release.
    ///
    @since(version = 0.2.0)
    release: func(key-def: key-def);

    /// Returns a list of key parts from a given key definition.
    ///
    /// The returned list is copied into guest-owned memory.
    ///
    /// ### Parameters
    /// - `key-def`: The key definition to inspect.
    ///
    /// ### Returns
    /// - List of `key-part` objects.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    dump-parts: func(key-def: key-def) -> result<list<key-part>, box-error>;

    /// Validates whether a given key conforms to the key definition.
    ///
    /// Checks the number of fields and their types, allowing partial matches
    /// (e.g. prefix of the full key).
    ///
    /// ### Parameters
    /// - `key-def`: Key definition to validate against.
    /// - `key`: One complete MessagePack array of key parts.
    ///
    /// ### Returns
    /// - `ok` if the key conforms to the definition.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    validate-key: func(key-def: key-def, key: msgpack-value) -> result<_, box-error>;

    /// Validates whether a key **fully** matches the key definition.
    ///
    /// Differs from `validate-key` by requiring exact number of parts.
    ///
    /// ### Parameters
    /// - `key-def`: Key definition to validate against.
    /// - `key`: One complete MessagePack array with exactly one item per key
    ///   part.
    ///
    /// ### Returns
    /// - `ok` if the key fully conforms to the definition.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    validate-full-key: func(key-def: key-def, key: msgpack-value) -> result<_, box-error>;

    /// Returns the number of parts in the key definition.
    ///
    /// Each part corresponds to one field used in index comparison or validation.
    ///
    /// ### Parameters
    /// - `key-def`: The key definition.
    ///
    /// ### Returns
    /// - Number of parts as `u32`.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    part-count: func(key-def: key-def) -> result<u32, box-error>;

    /// Extracts a key from a given tuple based on the key definition.
    ///
    /// The result is a MessagePack-encoded byte buffer representing the key,
    /// constructed by selecting fields from the input tuple as defined
    /// by the provided key definition.
    ///
    /// This buffer can be decoded using a MessagePack decoder and will contain
    /// an array of fields corresponding to the key parts.
    ///
    /// ### Parameters
    /// - `key-def`: Key definition describing how to extract fields.
    /// - `tuple`: Source `box-tuple`.
    ///
    /// ### Returns
    /// - One complete MessagePack array containing the extracted key fields.
    ///
    /// ### Errors
    /// - Returns a `box-error` if the tuple is invalid or extraction fails.
    @since(version = 0.2.0)
    extract-key: func(key-def: key-def, %tuple: box-tuple) -> result<msgpack-value, box-error>;

    /// Validates whether the tuple contains all required fields
    /// and types as specified by the key definition.
    ///
    /// This is useful to check if a `box-tuple` is compatible with an index.
    ///
    /// ### Parameters
    /// - `key-def`: Key definition to validate against.
    /// - `tuple`: A `box-tuple` to validate.
    ///
    /// ### Returns
    /// - `ok` if the tuple satisfies the key definition.
    ///
    /// A tuple that does not satisfy the definition is returned as a
    /// `box-error`; it is not a normal boolean result.
    @since(version = 0.2.0)
    validate-tuple: func(key-def: key-def, %tuple: box-tuple) -> result<_, box-error>;
}
