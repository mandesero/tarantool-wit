@since(version = 0.2.0)
/// Converts between JSON text and JSON-compatible MessagePack values.
interface msgpack {

    @since(version = 0.2.0)
    use types.{box-error, msgpack-value};

    /// Converts a JSON value to MessagePack.
    ///
    /// The input must contain one JSON value. The output contains the equivalent
    /// value encoded as one complete MessagePack value.
    ///
    /// ### Parameters
    /// - `json`: A string containing one valid JSON value.
    ///
    /// ### Returns
    /// - The corresponding MessagePack value.
    ///
    /// ### Errors
    /// - A `box-error` if `json` is malformed or cannot be represented.
    @since(version = 0.2.0)
    from-json: func(json: string) -> result<msgpack-value, box-error>;

    /// Converts a MessagePack value to JSON.
    ///
    /// Only values representable by the JSON data model are accepted. MessagePack
    /// extension values, binary values, and maps with non-string keys may fail.
    /// The returned JSON is not a canonical serialization.
    ///
    /// ### Parameters
    /// - `value`: One complete MessagePack value.
    ///
    /// ### Returns
    /// - A string containing the equivalent JSON value.
    ///
    /// ### Errors
    /// - A `box-error` if `value` is malformed or has no JSON representation.
    @since(version = 0.2.0)
    to-json: func(value: msgpack-value) -> result<string, box-error>;

}

