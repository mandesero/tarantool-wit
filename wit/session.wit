@since(version = 0.2.0)
/// Accesses the current session, broadcasts values, and sends IPROTO packets.
interface session {

    @since(version = 0.2.0)
    use types.{session, box-error, msgpack-value};

    /// Returns the current session.
    ///
    /// The record identifies the connection or execution context from which
    /// the current code runs. It does not own the session.
    ///
    /// ### Returns
    /// - A `session` object representing the current session.
    @since(version = 0.2.0)
    current: func() -> session;

    /// Broadcasts a message to all watchers subscribed to the given key.
    ///
    /// `value` is a Lua expression whose evaluated value is passed to
    /// `box.broadcast`. It is not JSON. Invalid expressions return an error;
    /// callers must not interpolate untrusted text into the expression.
    ///
    /// ### Parameters
    /// - `key`: A string event name to broadcast on.
    /// - `value`: A Lua expression, for example `"{a = 1}"`.
    ///
    /// ### Returns
    /// - `ok` on success, or a `box-error` on failure.
    ///
    /// ### Errors
    /// - A `box-error` if the key or Lua expression is invalid or broadcast
    ///   fails.
    @since(version = 0.2.0)
    broadcast: func(key: string, value: string) -> result<_, box-error>;

    /// Sends a raw IPROTO packet to a specific session.
    ///
    /// The header must be one complete MessagePack map. The optional body, when
    /// present, must also be one complete MessagePack map.
    ///
    /// ### Parameters
    /// - `session`: Target session to send to.
    /// - `header`: MessagePack map containing the request header.
    /// - `body`: `some` with a MessagePack map, or `none` to omit the body.
    ///
    /// ### Returns
    /// - `ok(())` after the packet is accepted for sending.
    ///
    /// ### Errors
    /// - A `box-error` describing the failure.
    @since(version = 0.2.0)
    iproto-send: func(
        session: session,
        header: msgpack-value,
        body: option<msgpack-value>,
    ) -> result<_, box-error>;
}
